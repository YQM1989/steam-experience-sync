# Required
STEAM_ID=your_steamid64
OBSIDIAN_VAULT_DIR=D:\Path\To\Your\ObsidianVault

# Optional: used only to enrich playtime from GetOwnedGames.
# Do not commit your real key.
STEAM_API_KEY=

# Optional overrides
STEAM_EXPERIENCE_DIR=00_输入源/50_我是谁/Steam体验记录
STEAM_SYNC_STATE=.obsidian/steam-experience-sync/state.json
STEAM_LOOKBACK_PAGES=1
STEAM_LIMIT=20
STEAM_MAX_MATCHES=all
STEAM_MAX_GAMES=all
STEAM_REQUEST_DELAY_MS=30000
STEAM_PAGE_DELAY_MS=60000

# Worker mode: poll the newest screenshot feed once per round.
STEAM_WORKER_MODE=feed
STEAM_WORKER_BATCH_SIZE=5
STEAM_WORKER_MAX_DETAIL_SCANS=3
STEAM_WORKER_COOLDOWN_ON_429_MS=28800000
STEAM_WORKER_LOOP_DELAY_MS=60000
STEAM_WORKER_LOG=.obsidian/steam-experience-sync/worker.log
STEAM_WORKER_STOP_FILE=.obsidian/steam-experience-sync/stop-worker
